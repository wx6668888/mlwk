{
  "name": "cirmano-global-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:client": "node scripts/prepare_casa.mjs && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-server",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && node scripts/prepare-pwa.mjs",
    "postbuild": "node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test:pwa": "node --test scripts/pwa-cache.test.mjs",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "prepare:casa": "node scripts/prepare_casa.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.110.0",
    "aws4fetch": "^1.0.20",
    "camofox-browser": "^2.4.6",
    "camoufox-js": "^0.11.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "three": "^0.181.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gsap": "3.13.0",
    "lenis": "1.1.14",
    "three-casa": "npm:three@0.160.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "wrangler": "^4.23.0"
  }
}
